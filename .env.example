# Copy to .env and adjust. Defaults target a local ollama; no key is required.

# OpenAI-compatible endpoint used for BOTH chat completions and embeddings.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
LLM_API_KEY=ollama
EMBED_MODEL=nomic-embed-text

# Embedding backend:
#   auto   = try the embeddings endpoint, fall back to offline TF-IDF (default)
#   remote = require the embeddings endpoint
#   tfidf  = always use the deterministic offline TF-IDF index
EMBED_BACKEND=auto

# Folder of support docs to index (defaults to ./sample_docs)
# DOCS_DIR=sample_docs
